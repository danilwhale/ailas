{
  "schemaVersion": 1,
  "id": "waila",
  "version": "${version}",
  "custom": {
    "waila:plugins": [
      {
        "id": "waila:core",
        "initializer": "mcp.mobius.waila.addons.core.PluginCore"
      },
      {
        "id": "waila:vanilla",
        "initializer": "mcp.mobius.waila.addons.minecraft.PluginMinecraft"
      }
    ]
  },

  "entrypoints": {
    "init": [
      "mcp.mobius.waila.Waila"
    ],
    "client-init": [
      "mcp.mobius.waila.WailaClient"
    ]
  },
  "mixins": [
    "waila.mixins.json"
  ],

  "name": "Ailas",
  "description": "Am I looking at something?",
  "icon": "assets/waila/icon.png",
  "contact": {
    "issues": "https://github.com/danilwhale/ailas/issues",
    "sources": "https://github.com/danilwhale/ailas"
  },
  "license": "CC BY NC SA 4.0",
  "authors": [
    {
      "name": "danilwhale",
      "contact": {
        "homepage": "https://danilwhale.github.io"
      }
    },
    {
      "name": "Nicholas \"TehNut\" Ignoffo",
      "contact": {
        "email": "nick@tehnut.info",
        "homepage": "https://tehnut.info"
      }
    },
    {
      "name": "ProfMobius",
      "contact": {
        "homepage": "https://twitter.com/profmobius"
      }
    }
  ],
  "contributors": [],

  "depends": {
    "fabricloader": ">=0.15.0",
    "minecraft": "1.14.4",
    "osl-entrypoints": ">=0.4.3",
    "osl-networking": ">=0.8.0",
    "osl-keybinds": ">=0.1.2"
  },
  "suggests": {
    "modmenu": "*"
  }
}
